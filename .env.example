# Copy to .env and fill in. .env is gitignored — never commit real values.
# In AWS these same keys are read from Secrets Manager, not from a file.

# ---------- runtime ----------
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- Supabase ----------
# Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard > Project Settings > API > JWT Settings > JWT Secret (legacy HS256 secret)
SUPABASE_JWT_SECRET=
# Dashboard > Project Settings > Database > Connection string > URI (session pooler, port 5432)
# postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
STORAGE_BUCKET=documents

# ---------- OpenAI ----------
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- RAG tuning (safe defaults, change deliberately) ----------
CHUNK_CHARS=3200
CHUNK_OVERLAP_CHARS=480
RETRIEVAL_TOP_K=8
CANDIDATE_POOL=30
MAX_REFINE_LOOPS=2
MAX_UPLOAD_MB=50
MIN_CHARS_PER_PAGE=40

# ---------- frontend ----------
# Where the Streamlit app reaches the API. In ECS this is the internal ALB listener.
BACKEND_URL=http://localhost:8000
